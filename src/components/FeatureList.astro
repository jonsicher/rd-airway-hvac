---
import Icon from './icons/Icon.astro';

interface Props {
  items: { label: string; text: string }[];
  onDark?: boolean;
  class?: string;
}

const { items, onDark = false, class: className = '' } = Astro.props;
// Split text so phone numbers like 914-373-1687 render as tappable tel: links.
const PHONE = /(\(?\d{3}\)?[ -]\d{3}-\d{4})/;
const parts = (text: string) => text.split(PHONE);
const tel = (n: string) => `tel:+1${n.replace(/\D/g, '')}`;
---
<ul class:list={['space-y-5', className]}>
  {items.map((it) => (
    <li class="flex gap-4">
      <span class:list={['mt-0.5 grid size-7 shrink-0 place-items-center rounded-full', onDark ? 'bg-white/10 text-brand-400' : 'bg-brand-100 text-brand-700']}>
        <Icon name="check" size={16} strokeWidth={3} />
      </span>
      <p>
        <strong class:list={['font-semibold', onDark ? 'text-white' : 'text-navy-900']}>{it.label}</strong>
        <span aria-hidden="true"> – </span><span class="sr-only">: </span>{parts(it.text).map((t, i) => (i % 2 ? <a href={tel(t)} class="font-semibold whitespace-nowrap">{t}</a> : t))}
      </p>
    </li>
  ))}
</ul>
