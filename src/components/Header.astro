---
import { site, telHref, mailHref } from '../data/site';
import Icon from './icons/Icon.astro';
import Button from './Button.astro';
import MobileMenu from './MobileMenu.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-white/95 backdrop-blur transition-[border-color,box-shadow] duration-200 data-[scrolled]:border-line-200 data-[scrolled]:shadow-[0_4px_20px_rgba(11,31,58,0.06)]">
  <!-- Top strip (desktop) -->
  <div class="hidden bg-navy-950 text-[0.8125rem] text-white/85 lg:block">
    <div class="container-site flex h-8 items-center justify-between gap-6">
      <div class="flex items-center gap-6">
        <a href={mailHref} class="inline-flex items-center gap-2 text-white/85 no-underline hover:text-white">
          <Icon name="mail" size={14} /> {site.email}
        </a>
        <span class="inline-flex items-center gap-2"><Icon name="clock" size={14} /> {site.hours}</span>
      </div>
      <span class="inline-flex items-center gap-2"><Icon name="map-pin" size={14} /> {site.serviceAreaShort}</span>
    </div>
  </div>

  <!-- Main bar -->
  <div class="container-site flex h-18 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="flex shrink-0 items-center rounded-lg" aria-label={`${site.name} — home`}>
      <img
        src={site.logo.src}
        width={site.logo.width}
        height={site.logo.height}
        alt={site.logo.alt}
        class="h-11 w-auto lg:h-[52px]"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-1 2xl:gap-2">
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative whitespace-nowrap rounded-full px-3 py-2 text-[0.9375rem] font-semibold no-underline transition-colors 2xl:px-4',
                isActive(item.href) ? 'text-brand-700' : 'text-navy-900 hover:text-brand-700',
              ]}
            >
              {item.label}
              {isActive(item.href) && <span class="absolute inset-x-3 -bottom-0.5 h-[3px] rounded-full bg-red-500 2xl:inset-x-4" aria-hidden="true" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <!-- Click-to-call: number on ≥ sm, round icon button on phones -->
      <a
        href={telHref}
        class="hidden shrink-0 items-center gap-2 rounded-full px-2 py-2 font-semibold text-navy-900 no-underline hover:text-brand-700 sm:inline-flex"
      >
        <span class="grid size-9 place-items-center rounded-full bg-brand-100 text-brand-700"><Icon name="phone" size={18} /></span>
        <span class="whitespace-nowrap">{site.phoneDisplay}</span>
      </a>
      <a
        href={telHref}
        class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-500 text-white no-underline sm:hidden"
        aria-label={`Call ${site.phoneDisplay}`}
      >
        <Icon name="phone" size={20} />
      </a>
      <div class="hidden md:block"><Button href={site.cta.href} class="whitespace-nowrap">{site.cta.label}</Button></div>
      <button
        type="button"
        id="menu-toggle"
        class="grid size-11 shrink-0 place-items-center rounded-full border border-line-200 text-navy-900 hover:bg-surface-50 xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<MobileMenu />

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
