---
import { site } from '../data/site';

interface Props {
  src?: string;
  title?: string;
  class?: string;
}

const {
  src = site.mapEmbed,
  title = 'Map of R.D. Airway HVAC service area around Cortlandt Manor, NY',
  class: className = '',
} = Astro.props;
---
<div class:list={['relative aspect-[4/3] overflow-hidden rounded-2xl bg-surface-50 shadow-card sm:aspect-video', className]}>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="absolute inset-0 h-full w-full border-0"
    allowfullscreen
  ></iframe>
</div>
<p class="mt-3 text-sm"><a href={site.mapLink} target="_blank" rel="noopener" class="font-semibold">Open map in Google Maps</a></p>
