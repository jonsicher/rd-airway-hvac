---
import { site, telHref } from '../data/site';
import Icon from './icons/Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<div id="mobile-menu-root" class="xl:hidden" hidden>
  <div data-menu-backdrop class="fixed inset-0 z-[60] bg-navy-950/60 opacity-0 transition-opacity duration-200"></div>
  <div
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    class="fixed inset-y-0 right-0 z-[70] flex w-full max-w-[20rem] translate-x-full flex-col bg-white shadow-2xl transition-transform duration-200 ease-out"
  >
    <div class="flex h-18 items-center justify-between border-b border-line-200 px-4">
      <span class="font-display text-lg font-bold text-navy-900">Menu</span>
      <button type="button" data-menu-close class="grid size-11 place-items-center rounded-full text-navy-900 hover:bg-surface-50" aria-label="Close menu">
        <Icon name="x" size={22} />
      </button>
    </div>
    <nav aria-label="Mobile" class="flex-1 overflow-y-auto px-4 py-4">
      <ul class="space-y-1">
        <li>
          <a href="/" aria-current={path === '/' ? 'page' : undefined} class:list={['block rounded-xl px-3 py-3 text-lg font-semibold no-underline', path === '/' ? 'bg-brand-50 text-brand-700' : 'text-navy-900 hover:bg-surface-50']}>Home</a>
        </li>
        {site.nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={['block rounded-xl px-3 py-3 text-lg font-semibold no-underline', isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-navy-900 hover:bg-surface-50']}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="space-y-3 border-t border-line-200 p-4">
      <a href={telHref} class="flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-red-600 px-6 py-3 font-semibold text-white no-underline hover:bg-red-700">
        <Icon name="phone" size={18} /> Call {site.phoneDisplay}
      </a>
      <a href={site.cta.href} class="flex min-h-12 w-full items-center justify-center gap-2 rounded-full border border-line-200 px-6 py-3 font-semibold text-navy-900 no-underline hover:bg-surface-50">
        {site.cta.label}
      </a>
      <p class="pt-1 text-center text-sm text-ink-600">{site.hours}</p>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById('mobile-menu-root');
  const panel = document.getElementById('mobile-menu');
  const toggle = document.getElementById('menu-toggle');
  const backdrop = root?.querySelector<HTMLElement>('[data-menu-backdrop]');
  const closeBtn = root?.querySelector<HTMLElement>('[data-menu-close]');

  if (root && panel && toggle && backdrop) {
    const focusables = () =>
      Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    const open = () => {
      root.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      toggle.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => {
        backdrop.classList.replace('opacity-0', 'opacity-100');
        panel.classList.remove('translate-x-full');
        closeBtn?.focus();
      });
      document.addEventListener('keydown', onKey);
    };

    const close = (returnFocus = true) => {
      backdrop.classList.replace('opacity-100', 'opacity-0');
      panel.classList.add('translate-x-full');
      toggle.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.setTimeout(() => (root.hidden = true), reduce ? 0 : 200);
      if (returnFocus) toggle.focus();
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') return close();
      if (e.key !== 'Tab') return;
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    toggle.addEventListener('click', () => (toggle.getAttribute('aria-expanded') === 'true' ? close() : open()));
    closeBtn?.addEventListener('click', () => close());
    backdrop.addEventListener('click', () => close());
    // Close when following an in-page link (e.g. /hvac/#emergency)
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close(false)));
    // Close if the viewport grows to desktop
    window.matchMedia('(min-width: 1280px)').addEventListener('change', (m) => {
      if (m.matches && !root.hidden) close(false);
    });
  }
</script>
