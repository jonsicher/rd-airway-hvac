---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  /** Show "Home / {title}" breadcrumb (default true). */
  breadcrumb?: boolean;
  /** 'sm' for policy pages. */
  size?: 'md' | 'sm';
}

const { eyebrow, title, subtitle, breadcrumb = true, size = 'md' } = Astro.props;
---
<section class:list={['on-dark relative isolate overflow-hidden bg-navy-gradient text-white', size === 'sm' ? 'py-12 lg:py-16' : 'py-14 lg:py-24']}>
  <svg class="pointer-events-none absolute -bottom-10 -right-16 -z-10 w-[28rem] max-w-[80vw] opacity-[0.14]" viewBox="0 0 400 160" fill="none" aria-hidden="true">
    <path d="M10 120 C 120 20, 260 20, 390 70" stroke="#3EA6DB" stroke-width="18" stroke-linecap="round" />
    <path d="M40 150 C 150 70, 270 70, 380 110" stroke="#CF534D" stroke-width="12" stroke-linecap="round" />
  </svg>
  <div class="container-site">
    {breadcrumb && (
      <nav aria-label="Breadcrumb" class="mb-5 text-sm text-white/70">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="text-white/80 no-underline hover:text-white hover:underline">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-white">{title}</li>
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow eyebrow-on-dark mb-4">{eyebrow}</p>}
    <h1 class="max-w-4xl text-white">{title}</h1>
    {subtitle && <p class="mt-5 max-w-2xl text-lg text-white/85 lg:text-xl">{subtitle}</p>}
    <slot />
  </div>
</section>
