---
// Typographic wrapper for long-form/policy text. Put verbatim text inside as plain HTML (h2, p, ul, a).
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<div class:list={['prose-site mx-auto max-w-prose', className]}>
  <slot />
</div>

<style is:global>
  .prose-site { color: var(--color-ink-600); }
  .prose-site > * + * { margin-top: 1.25em; }
  .prose-site h2 {
    margin-top: 2.25em;
    font-size: 1.125rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: var(--color-navy-900);
  }
  .prose-site h3 { margin-top: 1.75em; font-size: 1.0625rem; color: var(--color-navy-900); }
  .prose-site h2 + *, .prose-site h3 + * { margin-top: 0.75em; }
  .prose-site a { color: var(--color-brand-700); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .prose-site ul { list-style: disc; padding-left: 1.25em; }
  .prose-site ol { list-style: decimal; padding-left: 1.25em; }
  .prose-site li + li { margin-top: 0.5em; }
  .prose-site strong { color: var(--color-ink-900); }
</style>
