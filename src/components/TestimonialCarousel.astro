---
// Built on Carousel. Quotes must be verbatim from src/data/reviews.ts — no star ratings.
import Carousel from './Carousel.astro';

interface Item {
  quote: string;
  name: string;
  project?: string;
}

interface Props {
  items: Item[];
  ariaLabel?: string;
  /** ms between slides; 0 disables. Default 6000. Off under reduced motion. */
  autoplay?: number;
  onDark?: boolean;
  class?: string;
}

const { items, ariaLabel = 'Customer testimonials', autoplay = 6000, onDark = false, class: className = '' } = Astro.props;
---
<Carousel
  ariaLabel={ariaLabel}
  autoplay={autoplay}
  controls="below"
  showDots
  onDark={onDark}
  class:list={['mx-auto max-w-3xl', className]}
>
  {items.map((t) => (
    <figure class="m-0 px-1 text-center">
      <svg viewBox="0 0 48 36" width="56" height="42" aria-hidden="true" class:list={['mx-auto mb-6', onDark ? 'text-white/20' : 'text-brand-100']} fill="currentColor">
        <path d="M0 36V21.6C0 9.7 6.1 2.5 18.2 0l2.3 4.6C14.2 6.6 11 10.4 10.6 16H19v20H0Zm28.6 0V21.6C28.6 9.7 34.7 2.5 46.8 0l2.3 4.6c-6.3 2-9.5 5.8-9.9 11.4h8.4v20H28.6Z" />
      </svg>
      <blockquote class="m-0">
        <p class:list={['font-display text-xl font-medium leading-relaxed lg:text-2xl', onDark ? 'text-white' : 'text-navy-900']}>
          “{t.quote}”
        </p>
      </blockquote>
      <figcaption class="mt-6 flex flex-col items-center gap-2">
        <span class:list={['font-semibold', onDark ? 'text-white' : 'text-navy-900']}>— {t.name}</span>
        {t.project && (
          <span class:list={['rounded-full px-3 py-1 text-sm font-medium', onDark ? 'bg-white/10 text-white/90' : 'bg-brand-100 text-brand-700']}>{t.project}</span>
        )}
      </figcaption>
    </figure>
  ))}
</Carousel>
