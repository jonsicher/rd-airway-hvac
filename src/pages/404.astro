---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site, telHref } from '../data/site';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <section class="bg-surface-50 py-20 lg:py-32">
    <div class="container-site mx-auto max-w-2xl text-center">
      <img src={site.logo.src} width={site.logo.width} height={site.logo.height} alt={site.logo.alt} class="mx-auto h-16 w-auto" />
      <p class="eyebrow mt-10 justify-center">Error 404</p>
      <h1 class="mt-4">Page not found</h1>
      <p class="mt-5 text-lg">Sorry, we couldn’t find that page. It may have moved when we refreshed our website.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href="/" size="lg" icon="home">Back to home</Button>
        <Button href={telHref} size="lg" variant="secondary" icon="phone">Call {site.phoneDisplay}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
