---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ImageCarousel from '../components/ImageCarousel.astro';
import ContactBand from '../components/ContactBand.astro';
import CtaBand from '../components/CtaBand.astro';
import Button from '../components/Button.astro';
import Icon from '../components/icons/Icon.astro';
import { services } from '../data/services';
import { imgs } from '../data/images';
import { site, telHref } from '../data/site';

const routine = services.find((s) => s.id === 'routine')!;
const icons = ['piggy-bank', 'alert-triangle', 'calendar', 'shield-check'] as const;
const seasons = [
  { icon: 'sun', title: 'End of Spring', note: 'Before the cooling season' },
  { icon: 'leaf', title: 'Beginning of Fall', note: 'After a summer of daily use' },
] as const;
const photos = imgs('tech-attic-install', 'tech-basement-ceiling-install', 'tech-condenser-gauges', 'ecobee-smart-thermostat', 'nest-thermostat');
---
<BaseLayout
  title="HVAC Maintenance & Tune Ups | R.D. Airway HVAC"
  description="Annual AC service and seasonal tune ups in Westchester County and the Hudson Valley. Avoid summer breakdowns — one year service guarantee on new installs."
>
  <PageHero eyebrow="Routine Service" title="Routine Maintenance" subtitle={routine.intro}>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={telHref} icon="phone" size="lg">Call {site.phoneDisplay}</Button>
      <Button href={site.cta.href} variant="secondary" onDark size="lg">{site.cta.label}</Button>
    </div>
  </PageHero>

  <Section eyebrow="Why it matters" title="Keep your system running at its best.">
    <div class="grid gap-6 sm:grid-cols-2">
      {routine.bullets.map((b, i) => (
        <ServiceCard icon={icons[i]} title={b.label} text={b.text} />
      ))}
    </div>
  </Section>

  <Section bg="soft" eyebrow="When to schedule" title="Two tune ups a year, timed right." align="center">
    <p class="mx-auto max-w-2xl text-lg text-ink-600">The best time to service your home's AC is at the beginning of Fall, and the end of Spring.</p>
    <div class="mx-auto mt-10 grid max-w-3xl gap-6 sm:grid-cols-2">
      {seasons.map((s) => (
        <div class="card flex flex-col items-center p-8 text-center">
          <span class="mb-5 grid size-14 place-items-center rounded-2xl bg-brand-100 text-brand-700"><Icon name={s.icon} size={28} /></span>
          <h3 class="text-xl">{s.title}</h3>
          <p class="mt-2">{s.note}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section pad="sm" class="pt-16 lg:pt-24">
    <div class="bg-navy-gradient flex flex-col items-start gap-6 rounded-3xl p-8 text-white sm:flex-row sm:items-center sm:p-12">
      <span class="grid size-16 shrink-0 place-items-center rounded-2xl bg-white/10 text-white"><Icon name="shield-check" size={34} /></span>
      <div>
        <h2 class="text-2xl text-white lg:text-3xl">One year service guarantee</h2>
        <p class="mt-3 max-w-3xl text-white/85">All of our new installs are backed by a one year service guarantee. During that time, we cover tune ups and installation checks at no cost to you for one year.</p>
      </div>
    </div>
  </Section>

  <Section eyebrow="Our work" title="Quality you can see." intro="A look at recent installations and equipment we work with.">
    <ImageCarousel images={photos} ariaLabel="Maintenance and installation photos" showDots aspect="16/10" sizes="(min-width: 1280px) 1200px, 100vw" />
  </Section>

  <Section pad="sm" class="pb-16 lg:pb-24">
    <a href="/hvac/" class="card card-hover group flex flex-col items-start justify-between gap-4 p-8 no-underline sm:flex-row sm:items-center lg:p-10">
      <div>
        <h2 class="text-2xl lg:text-3xl">Looking for installation or emergency repairs?</h2>
        <p class="mt-2">See everything we offer on our HVAC Services page.</p>
      </div>
      <span class="inline-flex items-center gap-2 font-semibold text-brand-700">
        HVAC Services <Icon name="arrow-right" size={20} class="transition-transform group-hover:translate-x-1" />
      </span>
    </a>
  </Section>

  <ContactBand />
  <CtaBand title="Keep your system running right." text={`Schedule a service maintenance call at ${site.phoneDisplay}`} />
</BaseLayout>
